<UserControl x:Class="NasaApodApp.Views.SlideBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:NasaApodApp.Views"
             Focusable="True">

  <UserControl.Resources>
    <!-- Shared by all four pickers. Each instance adds only the DataTrigger naming the flag
         that decides whether it is the one still empty. -->
    <Style x:Key="DatePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinWidth" Value="130" />
    </Style>

    <Style x:Key="PickerLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- The detail rows all share one shape: a muted field name, then its value. -->
    <Style x:Key="FieldName" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- A read-only TextBox rather than a TextBlock: the values here are addresses and long
         descriptions that are worth selecting and copying, which a TextBlock cannot do. The
         chrome is stripped so it still reads as text on the panel, not as an input field. -->
    <Style x:Key="FieldValue" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,15" />
      <Setter Property="Cursor" Value="IBeam" />
    </Style>

    <!-- One row of the day list on the left. -->
    <Style x:Key="DayListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="RowChrome" Background="Transparent" CornerRadius="5" />
              <Border x:Name="HoverGlow"
                      Background="#1F2634"
                      CornerRadius="5"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="{StaticResource HoverFadeIn}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="{StaticResource HoverFadeOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <!-- Selection is a state, not a passing highlight, so it lands at once. -->
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="#2A3F63" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Arrow keys step slides, so browsing a span never needs the mouse. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Left" Command="{Binding MovePreviousCommand}" />
    <KeyBinding Key="Right" Command="{Binding MoveNextCommand}" />
    <KeyBinding Key="Home" Command="{Binding MoveFirstCommand}" />
    <KeyBinding Key="End" Command="{Binding MoveLastCommand}" />
    <KeyBinding Key="Enter" Command="{Binding ToggleDetailCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ToggleDetailCommand}" />
  </UserControl.InputBindings>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Row 0 — the request: which months, and the two date parameters they become -->
    <Border Grid.Row="0"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="6"
                   Text="Astronomy Picture of the Day"
                   FontSize="17" FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <!-- Row 1 — start date. The day is not chosen: it is always the 1st of this month. -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="start date:" Style="{StaticResource RowLabel}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Month" Style="{StaticResource PickerLabel}" Margin="0,0,8,0" />
        <!-- ItemTemplate rather than DisplayMemberPath: the custom ComboBox control template
             renders the closed box through SelectionBoxItemTemplate, which only tracks an
             explicit ItemTemplate. With DisplayMemberPath the closed box showed a type name. -->
        <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,18,0"
                  ItemsSource="{Binding SelectableMonths}"
                  SelectedItem="{Binding StartMonth, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DatePicker}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStartMonthMissing}" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource ErrorText}" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="3" Text="Year" Style="{StaticResource PickerLabel}" Margin="0,0,8,0" />
        <ComboBox Grid.Row="1" Grid.Column="4"
                  ItemsSource="{Binding SelectableYears}"
                  SelectedItem="{Binding StartYear, Mode=TwoWay}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DatePicker}">
              <Setter Property="MinWidth" Value="100" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStartYearMissing}" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource ErrorText}" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>

        <!-- Row 2 — end date, always the last day of this month. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="end date:" Style="{StaticResource RowLabel}" Margin="0,12,14,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Month" Style="{StaticResource PickerLabel}" Margin="0,12,8,0" />
        <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,12,18,0"
                  ItemsSource="{Binding SelectableMonths}"
                  SelectedItem="{Binding EndMonth, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DatePicker}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEndMonthMissing}" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource ErrorText}" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="3" Text="Year" Style="{StaticResource PickerLabel}" Margin="0,12,8,0" />
        <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,12,0,0"
                  ItemsSource="{Binding SelectableYears}"
                  SelectedItem="{Binding EndYear, Mode=TwoWay}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DatePicker}">
              <Setter Property="MinWidth" Value="100" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEndYearMissing}" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource ErrorText}" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>

        <!-- Row 3 — the span those two months resolve to, and the button that requests it -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,16,0,0">
          <TextBlock Text="{Binding RequestRangeText}"
                     Style="{StaticResource MutedLabel}"
                     FontSize="13" VerticalAlignment="Center"
                     Margin="0,0,18,0" />

          <TextBlock Text="Please select date"
                     Foreground="{StaticResource ErrorText}"
                     FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                     Margin="0,0,18,0"
                     Visibility="{Binding HasMissingDate, Converter={StaticResource TrueToVisible}}" />

          <Button Content="Get APOD"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding FetchMonthCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Row 1 — one line of feedback: either what just happened, or what went wrong -->
    <Grid Grid.Row="1" Margin="4,12,4,0">
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource MutedLabel}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasError, Converter={StaticResource FalseToVisible}}" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{StaticResource ErrorText}"
                 FontSize="12" TextWrapping="Wrap"
                 Visibility="{Binding HasError, Converter={StaticResource TrueToVisible}}" />
    </Grid>

    <!-- Row 2 — the list of days, the day on screen, and its detail -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <!-- Auto on both sides: a hidden panel collapses to nothing and gives the middle
             its width back rather than leaving a gap. -->
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left — every day in the span, the list the requirement asks for -->
      <Border Grid.Column="0" Width="270" Margin="0,0,14,0"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{Binding HasSlides, Converter={StaticResource TrueToVisible}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="16,13,16,11"
                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding SlidePositionText}" FontSize="14" FontWeight="SemiBold" />
          </Border>

          <!-- SelectedItem two-way: picking here moves the slide, and stepping with the
               buttons moves the highlight. IsSynchronizedWithCurrentItem is off so the two
               do not fight over which one is authoritative. -->
          <ListBox x:Name="DayList" Grid.Row="1"
                   ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   IsSynchronizedWithCurrentItem="False"
                   ItemContainerStyle="{StaticResource DayListItem}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnDaySelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Date}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <!-- Marks the days that are film rather than a photograph. -->
                    <TextBlock Text="VIDEO"
                               Foreground="{StaticResource MutedText}"
                               FontSize="9" FontWeight="SemiBold"
                               Margin="8,1,0,0"
                               Visibility="{Binding IsImage, Converter={StaticResource FalseToVisible}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Title}"
                             FontSize="12.5" TextWrapping="Wrap"
                             Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Middle — the day itself -->
      <Border Grid.Column="1"
              Background="#0F131B"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14">
            <Image Source="{Binding CurrentPicture}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- A video NASA hosts as its own file plays here, with its own transport
                 controls. VideoSource is null on every other day, which releases the clip. -->
            <vw:VideoPlayerPanel VideoSource="{Binding CurrentVideoUri}"
                                 Visibility="{Binding IsCurrentEntryPlayable, Converter={StaticResource TrueToVisible}}" />

            <TextBlock Text="Loading picture ..."
                       Style="{StaticResource MutedLabel}"
                       FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsPictureLoading, Converter={StaticResource TrueToVisible}}" />

            <!-- The video has to be on disk before it can play, and these files run to tens
                 of megabytes, so the wait is reported rather than left blank. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsVideoDownloading, Converter={StaticResource TrueToVisible}}">
              <TextBlock Text="{Binding VideoDownloadText}"
                         Style="{StaticResource MutedLabel}"
                         FontSize="14" HorizontalAlignment="Center" />
              <!-- OneWay explicitly: ProgressBar.Value binds two-way by default, which fails
                   against a get-only property. -->
              <ProgressBar Value="{Binding VideoDownloadPercent, Mode=OneWay}" Maximum="100"
                           Width="260" Height="4" Margin="0,10,0,0"
                           Background="#2A3140"
                           Foreground="{StaticResource AccentBrush}"
                           BorderThickness="0" />
            </StackPanel>

            <TextBlock Text="Choose a start month and an end month, then press Get APOD."
                       Style="{StaticResource MutedLabel}"
                       FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSlides, Converter={StaticResource FalseToVisible}}" />

            <!-- Nothing to draw and nothing to play: an embedded video with no thumbnail. -->
            <TextBlock Style="{StaticResource MutedLabel}"
                       FontSize="14" TextWrapping="Wrap" MaxWidth="560"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsCurrentEntryBlank, Converter={StaticResource TrueToVisible}}"
                       Text="This day's entry is a video hosted elsewhere, and NASA supplies no thumbnail for it. The address is in the detail panel." />

            <!-- Sits over the top-right corner of the media, out of the way of the picture.
                 Only offers to open: once the panel is open it steps aside, because the panel
                 heading then carries the Hide control. -->
            <Button Content="Show Detail"
                    Style="{StaticResource OverlayButton}"
                    Command="{Binding ToggleDetailCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="72" Margin="0,4,4,0"
                    Visibility="{Binding CanOfferDetail, Converter={StaticResource TrueToVisible}}" />
          </Grid>

          <!-- Caption for the day on screen -->
          <StackPanel Grid.Row="1" Margin="18,0,18,16"
                      Visibility="{Binding HasSlides, Converter={StaticResource TrueToVisible}}">
            <TextBlock Text="{Binding CurrentEntry.Date}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentEntry.Title}"
                       FontSize="19" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Right — every field the response carried for this day -->
      <Border Grid.Column="2" Width="360" Margin="14,0,0,0"
              Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource TrueToVisible}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="18,14,18,12"
                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock Text="Detail" FontSize="15" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <!-- The only way to close the panel, sitting in its heading where a close
                   control belongs. -->
              <Button Content="Hide" Command="{Binding ToggleDetailCommand}"
                      Style="{StaticResource OverlayDismissButton}"
                      HorizontalAlignment="Right" MinWidth="58" />
            </Grid>
          </Border>

          <!-- Hidden rather than shown empty when there is no day to describe: a column of
               field names with nothing beside them reads as data that failed to arrive. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,18"
                        Visibility="{Binding HasSlides, Converter={StaticResource TrueToVisible}}">
            <StackPanel DataContext="{Binding CurrentEntry}">
              <TextBlock Text="date" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding Date, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="title" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding Title, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="copyright" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding CopyrightText, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="media_type" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding MediaType, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="service_version" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding ServiceVersionText, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="url" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding Url, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="hdurl" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding HdUrlText, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="thumbnail_url" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding ThumbnailUrlText, Mode=OneWay}" Style="{StaticResource FieldValue}" />

              <TextBlock Text="explanation" Style="{StaticResource FieldName}" />
              <TextBox Text="{Binding Explanation, Mode=OneWay}" Style="{StaticResource FieldValue}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Laid over the whole content area while a request is in flight. Two jobs at once:
           it says the program is working, and it takes the clicks. A Border with a background
           is hit-testable, so nothing underneath can be reached while it is up — no stepping
           to a day that is about to be replaced, and no reading a list mid-swap.

           Declared last so it sits above the three panels, and spanning every column so none
           of them is left exposed. -->
      <Border Grid.Column="0" Grid.ColumnSpan="3"
              Background="#CC0B0E14"
              CornerRadius="8"
              Visibility="{Binding IsFetching, Converter={StaticResource TrueToVisible}}">
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- The track the moving arc runs on, so the spinner reads as a ring rather than
               as a lone stroke drifting in the dark. -->
          <Ellipse Stroke="#2A3140" StrokeThickness="4" Margin="4" />

          <!-- One quarter of the ring, turning. StrokeDashArray counts in multiples of the
               stroke thickness, so 9 on and 26 off is roughly a quarter of this circumference.

               The turn is started and stopped with the overlay rather than left running for
               the life of the window, so nothing is animated while the app sits idle. The
               trigger lives on this element and animates this element, with no TargetName to
               resolve — a storyboard started from a style cannot reliably reach a name
               declared elsewhere in the view. -->
          <Ellipse Stroke="{StaticResource AccentBrush}"
                   StrokeThickness="4"
                   StrokeDashArray="9 26"
                   StrokeStartLineCap="Round"
                   StrokeEndLineCap="Round"
                   Margin="4"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform />
            </Ellipse.RenderTransform>
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFetching}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard x:Name="SpinnerTurn">
                        <Storyboard>
                          <DoubleAnimation
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                              From="0" To="360"
                              Duration="0:0:0.9"
                              RepeatBehavior="Forever" />
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="SpinnerTurn" />
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
        </Grid>
      </Border>
    </Grid>

    <!-- Row 3 — stepping through the span -->
    <Grid Grid.Row="3" Margin="0,14,0,0"
          Visibility="{Binding HasSlides, Converter={StaticResource TrueToVisible}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="First" Command="{Binding MoveFirstCommand}" Margin="0,0,8,0" MinWidth="66" />
        <Button Content="&lt; Previous" Command="{Binding MovePreviousCommand}" Margin="0,0,14,0" />

        <TextBlock Text="{Binding SlidePositionText}"
                   FontSize="13" MinWidth="110"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Button Content="Next &gt;" Command="{Binding MoveNextCommand}" Margin="14,0,8,0" />
        <Button Content="Last" Command="{Binding MoveLastCommand}" MinWidth="66" />
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
