<Window x:Class="NasaApodApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vw="clr-namespace:NasaApodApp.Views"
        Title="NASA - APOD"
        Icon="pack://application:,,,/NasaApod;component/AppIcon.ico"
        Height="820" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        TextElement.Foreground="{StaticResource PrimaryText}"
        TextElement.FontFamily="Segoe UI">

  <!-- One screen. The day's full detail opens as a panel inside it rather than as a
       separate page, so the picture stays on screen next to its data. -->
  <vw:SlideBrowserView DataContext="{Binding SlideBrowser}" />

</Window>
