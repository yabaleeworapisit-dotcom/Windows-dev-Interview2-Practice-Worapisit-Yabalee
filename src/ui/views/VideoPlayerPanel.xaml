<UserControl x:Class="NasaApodApp.Views.VideoPlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- A flat transport slider: a thin track with a small round grip, so the controls read
         as part of the dark shell rather than as a Windows dialog dropped onto it. -->
    <Style x:Key="ScrubBar" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="#2A3140" />
              <Border x:Name="PlayedPart" Height="4" CornerRadius="2"
                      Background="{StaticResource AccentBrush}"
                      HorizontalAlignment="Left" />
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12"
                                 Fill="{StaticResource PrimaryText}"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Manual behaviour on both ends: the transport bar below owns when this plays, pauses
         and rewinds, which the automatic behaviours would otherwise decide for it. -->
    <MediaElement x:Name="Player" Grid.Row="0"
                  Stretch="Uniform"
                  LoadedBehavior="Manual"
                  UnloadedBehavior="Manual"
                  ScrubbingEnabled="True"
                  MediaOpened="OnMediaOpened"
                  MediaEnded="OnMediaEnded"
                  MediaFailed="OnMediaFailed" />

    <Border Grid.Row="1" Margin="0,10,0,0"
            Background="#CC151A23"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="PlayPauseButton" Grid.Column="0"
                Style="{StaticResource TransportButton}"
                Content="⏸"
                Click="OnPlayPauseClicked" />

        <Button Grid.Column="1" Margin="8,0,14,0"
                Style="{StaticResource TransportButton}"
                Content="⏮"
                ToolTip="Back to the start"
                Click="OnRestartClicked" />

        <Slider x:Name="ScrubSlider" Grid.Column="2"
                Style="{StaticResource ScrubBar}"
                Minimum="0" Maximum="1" Value="0"
                Thumb.DragStarted="OnScrubStarted"
                Thumb.DragCompleted="OnScrubFinished"
                PreviewMouseLeftButtonUp="OnScrubClicked" />

        <TextBlock x:Name="TimeLabel" Grid.Column="3"
                   Margin="14,0,0,0"
                   Foreground="{StaticResource MutedText}"
                   FontSize="12" FontFamily="Consolas"
                   VerticalAlignment="Center"
                   Text="0:00 / 0:00" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
