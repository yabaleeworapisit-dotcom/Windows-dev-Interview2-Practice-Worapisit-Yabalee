# Normalise line endings in the repository, and check them out as the platform expects.
# Without this git warns about a conversion on every single file the first time it stages them.
* text=auto

# Sources are Windows-native; keeping them CRLF avoids noise in Visual Studio.
*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.slnx    text eol=crlf
*.ps1     text eol=crlf

*.md      text eol=lf
*.json    text eol=lf

# Anything below is bytes, not text, and must never be converted.
*.pdf     binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.mp4     binary
